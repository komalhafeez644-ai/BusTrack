<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet_dialog"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvDialogStudentName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Student Name (ID)"
        android:textColor="@color/primaryDark"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Morning Pickup"
        android:textColor="#64748B"
        android:textSize="12sp" />

    <Spinner
        android:id="@+id/spinnerMorningPickup"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_search_bar"
        android:backgroundTint="#F1F5F9" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Morning Drop"
        android:textColor="#64748B"
        android:textSize="12sp" />

    <Spinner
        android:id="@+id/spinnerMorningDrop"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_search_bar"
        android:backgroundTint="#F1F5F9" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Evening Pickup"
        android:textColor="#64748B"
        android:textSize="12sp" />

    <Spinner
        android:id="@+id/spinnerEveningPickup"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_search_bar"
        android:backgroundTint="#F1F5F9" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Evening Drop"
        android:textColor="#64748B"
        android:textSize="12sp" />

    <Spinner
        android:id="@+id/spinnerEveningDrop"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_search_bar"
        android:backgroundTint="#F1F5F9" />

    <Button
        android:id="@+id/btnSaveAttendance"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="24dp"
        android:backgroundTint="@color/status_green"
        android:text="SAVE ATTENDANCE"
        android:textColor="@color/white"
        android:textStyle="bold" />

</LinearLayout>
