<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    tools:context="ui.admin.ApplicationDetailActivity">

    <!-- TOP BAR -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:background="@color/primaryDark"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/outline_arrow_back_24"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@android:color/white"
            android:contentDescription="Back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="Fleet Control"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            android:textSize="20sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/btnBack"
            app:layout_constraintTop_toTopOf="parent"/>

        <ImageView
            android:id="@+id/btnNotification"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="16dp"
            android:src="@drawable/notifications"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/ivProfileTop"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/white"
            android:contentDescription="Notifications" />

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivProfileTop"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_person"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/white"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
            android:contentDescription="Profile" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- CONTENT -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Application Details"
                android:textColor="@color/primaryDark"
                android:textSize="28sp"
                android:textStyle="bold"/>

            <!-- STATUS CHIPS -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvApplicationId"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chip_selected"
                    android:backgroundTint="#E3F2FD"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp"
                    android:text="#APP-2025-001"
                    android:textColor="#1565C0"
                    android:textSize="13sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/tvStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/bg_chip_selected"
                    android:backgroundTint="#FEF3C7"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp"
                    android:text="Pending"
                    android:textColor="#D97706"
                    android:textSize="13sp"
                    android:textStyle="bold"/>
            </LinearLayout>

            <TextView
                android:id="@+id/tvDateTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Today, 08:45 AM"
                android:textColor="#64748B"
                android:textSize="14sp"
                app:drawableStartCompat="@drawable/outline_assignment_24"
                app:drawableTint="#64748B"
                android:drawablePadding="8dp"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="24dp"
                android:background="#E2E8F0" />

            <!-- STUDENT CARD -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/ivStudentProfile"
                            android:layout_width="86dp"
                            android:layout_height="88dp"
                            android:background="#F1F5F9"
                            android:padding="5dp"
                            android:src="@drawable/ic_person"
                            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="20dp"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvStudentName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Aryan Sharma"
                                android:textStyle="bold"
                                android:textSize="22sp"
                                android:textColor="@color/primaryDark"/>

                            <TextView
                                android:id="@+id/tvStudentInfo"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Grade 10 - Section B"
                                android:textColor="@color/lightGray"
                                android:textSize="14sp"/>

                            <TextView
                                android:id="@+id/tvParentName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Parent: Rajesh Sharma"
                                android:textColor="@color/lightGray"
                                android:textSize="14sp"/>

                            <TextView
                                android:id="@+id/tvPhone"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="+91 98765 43210"
                                android:textColor="@color/lightGray"
                                android:textSize="14sp"
                                app:drawableStartCompat="@drawable/ic_person"
                                app:drawableTint="#64748B"
                                android:drawablePadding="6dp"/>
                        </LinearLayout>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="20dp"
                        android:background="#F1F5F9" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PICKUP LOCATION"
                        android:textStyle="bold"
                        android:textColor="@color/lightGray"
                        android:textSize="11sp"
                        android:letterSpacing="0.05"
                        app:drawableStartCompat="@drawable/outline_location"
                        app:drawableTint="#94A3B8"
                        android:drawablePadding="6dp"/>

                    <TextView
                        android:id="@+id/tvPickupAddress"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="C-42, Sector 15"
                        android:textStyle="bold"
                        android:textSize="18sp"
                        android:textColor="@color/primaryDark"/>

                    <TextView
                        android:id="@+id/tvCity"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Vasundhara Enclave, New Delhi"
                        android:textColor="#64748B"
                        android:textSize="14sp"/>

                    <TextView
                        android:id="@+id/btnViewOnMap"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="View on Map"
                        android:textColor="@color/primaryBlue"
                        android:textStyle="bold"
                        android:textSize="15sp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- SYSTEM ANALYSIS CARD -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SYSTEM ANALYSIS"
                        android:textStyle="bold"
                        android:textColor="@color/lightGray"
                        android:textSize="11sp"
                        android:letterSpacing="0.05"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Nearest Route"
                        android:textColor="@color/lightGray"
                        android:textSize="13sp"/>

                    <TextView
                        android:id="@+id/tvRouteName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Route 5 (Express)"
                        android:textColor="@color/primaryBlue"
                        android:textStyle="bold"
                        android:textSize="18sp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Distance from Route"
                        android:textColor="@color/lightGray"
                        android:textSize="13sp"/>

                    <TextView
                        android:id="@+id/tvDistance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="1.2 KM"
                        android:textColor="@color/primaryBlue"
                        android:textStyle="bold"
                        android:textSize="18sp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Nearest Stop"
                        android:textColor="@color/lightGray"
                        android:textSize="13sp"/>

                    <TextView
                        android:id="@+id/tvNearestStop"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Green Park Phase 2 (0.8 KM away)"
                        android:textColor="@color/primaryBlue"
                        android:textStyle="bold"
                        android:textSize="18sp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:background="@drawable/bg_chip_selected"
                        android:backgroundTint="#DCFCE7"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="8dp"
                        android:text="Covered by Route"
                        android:textColor="#166534"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        app:drawableStartCompat="@drawable/person_check"
                        app:drawableTint="#166534"
                        android:drawablePadding="8dp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- BUTTONS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:layout_marginBottom="24dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnApprove"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="10dp"
                    android:text="Approve"
                    android:textAllCaps="false"
                    android:textColor="#14532D"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:backgroundTint="#DCFCE7"
                    app:cornerRadius="20dp"
                    app:strokeWidth="2dp"
                    app:strokeColor="#BBF7D0"
                    app:icon="@drawable/person_check"
                    app:iconTint="#14532D"
                    app:iconGravity="textStart"
                    app:iconPadding="8dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnReject"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:text="Reject"
                    android:textAllCaps="false"
                    android:textColor="#7F1D1D"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:backgroundTint="#FEE2E2"
                    app:cornerRadius="20dp"
                    app:strokeWidth="2dp"
                    app:strokeColor="#FECACA"
                    app:icon="@drawable/ic_close"
                    app:iconTint="#7F1D1D"
                    app:iconGravity="textStart"
                    app:iconPadding="8dp"/>

            </LinearLayout>
        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
