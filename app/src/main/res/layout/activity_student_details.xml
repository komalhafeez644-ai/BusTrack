<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F9FC">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <View
                android:id="@+id/headerView"
                android:layout_width="match_parent"
                android:layout_height="350dp"
                android:background="#0A1D37"
                app:layout_constraintTop_toTopOf="parent"
                tools:layout_editor_absoluteX="-16dp" />

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_margin="16dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/outline_arrow_back_24"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@android:color/white" />

            <TextView
                android:id="@+id/tvHeaderTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Fleet Control"
                android:textColor="@android:color/white"
                android:textSize="20sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="@id/btnBack"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/btnBack" />

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/imgStudentProfile"
                android:layout_width="110dp"
                android:layout_height="110dp"
                android:layout_marginTop="20dp"
                android:scaleType="centerCrop"
                tools:src="@drawable/img"
                android:background="#FFFFFF"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvHeaderTitle"
                app:shapeAppearanceOverlay="@style/CircleImage"
                app:strokeColor="#33FFFFFF"
                app:strokeWidth="4dp" />

            <TextView
                android:id="@+id/tvStudentName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="@android:color/white"
                android:textSize="24sp"
                android:textStyle="bold"
                tools:text="Ali Hassan"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/imgStudentProfile" />

            <TextView
                android:id="@+id/tvStudentId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#8EA1B4"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="STUDENT ID: ST-2045"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvStudentName" />

            <LinearLayout
                android:id="@+id/layoutBadgeContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvStudentId">

                <TextView
                    android:id="@+id/tvBadgeSemester"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@android:drawable/toast_frame"
                    android:backgroundTint="#4385F4"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:textColor="@android:color/white"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    tools:text="BS It 7th semester" />

                <TextView
                    android:id="@+id/tvStatusBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@android:drawable/toast_frame"
                    android:backgroundTint="#EF4444"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:text="UNASSIGNED"
                    android:textColor="@android:color/white"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <androidx.cardview.widget.CardView
                android:id="@+id/mainDetailCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="24dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="24dp"
                app:cardElevation="4dp"
                app:layout_constraintTop_toBottomOf="@id/layoutBadgeContainer">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="20dp">

                        <View
                            android:layout_width="4dp"
                            android:layout_height="20dp"
                            android:background="#005DB7"
                            android:layout_centerVertical="true"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_toEndOf="@id/viewVerticalBar"
                            android:text="Student Transport Details"
                            android:textColor="@color/black"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:layout_centerVertical="true"/>

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/switchTransportStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:checked="true"
                            app:trackTint="@color/switch_track_selector"
                            app:thumbTint="@color/white"
                            android:visibility="gone"
                            tools:visibility="visible"/>

                        <View
                            android:id="@+id/viewVerticalBar"
                            android:layout_width="0dp"
                            android:layout_height="0dp"/>
                    </RelativeLayout>

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp">

                        <ImageView
                            android:id="@+id/ivRouteIcon"
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:background="@android:drawable/toast_frame"
                            android:backgroundTint="#EDF4FF"
                            android:padding="10dp"
                            android:src="@drawable/alt_route"
                            app:tint="#005DB7" />

                        <TextView
                            android:id="@+id/lblRoute"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_toEndOf="@id/ivRouteIcon"
                            android:layout_marginStart="12dp"
                            android:text="ASSIGNED ROUTE"
                            android:textColor="#8E8E93"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvRouteName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_below="@id/lblRoute"
                            android:layout_toEndOf="@id/ivRouteIcon"
                            android:layout_marginStart="12dp"
                            android:layout_marginTop="2dp"
                            android:textColor="@color/black"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            tools:text="Route 12-A" />
                    </RelativeLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#E5E5EA"
                        android:layout_marginBottom="16dp"
                        android:layout_marginStart="54dp"/>

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp">

                        <ImageView
                            android:id="@+id/ivStopIcon"
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:background="@android:drawable/toast_frame"
                            android:backgroundTint="#EDF4FF"
                            android:padding="10dp"
                            android:src="@drawable/outline_location"
                            app:tint="#005DB7" />

                        <TextView
                            android:id="@+id/lblStop"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_toEndOf="@id/ivStopIcon"
                            android:layout_marginStart="12dp"
                            android:text="ASSIGNED STOP"
                            android:textColor="#8E8E93"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvAssignedStop"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_below="@id/lblStop"
                            android:layout_toEndOf="@id/ivStopIcon"
                            android:layout_marginStart="12dp"
                            android:layout_marginTop="2dp"
                            android:textColor="@color/black"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            tools:text="Sector 15 North" />
                    </RelativeLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#E5E5EA"
                        android:layout_marginBottom="16dp"
                        android:layout_marginStart="54dp"/>

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp">

                        <ImageView
                            android:id="@+id/ivAddressIcon"
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:background="@android:drawable/toast_frame"
                            android:backgroundTint="#EDF4FF"
                            android:padding="10dp"
                            android:src="@drawable/outline_location"
                            app:tint="#FF9500" />

                        <TextView
                            android:id="@+id/lblAddress"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_toEndOf="@id/ivAddressIcon"
                            android:layout_marginStart="12dp"
                            android:text="RESIDENTIAL ADDRESS"
                            android:textColor="#8E8E93"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvHomeAddress"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_below="@id/lblAddress"
                            android:layout_toEndOf="@id/ivAddressIcon"
                            android:layout_marginStart="12dp"
                            android:layout_marginTop="2dp"
                            android:textColor="@color/black"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            tools:text="House #123, Street 4, Islamabad" />
                    </RelativeLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#E5E5EA"
                        android:layout_marginBottom="16dp"
                        android:layout_marginStart="54dp"/>

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="24dp">

                        <ImageView
                            android:id="@+id/ivBusIcon"
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:background="@android:drawable/toast_frame"
                            android:backgroundTint="#EDF4FF"
                            android:padding="10dp"
                            android:src="@drawable/directions_bus_unfilled"
                            app:tint="#005DB7" />

                        <TextView
                            android:id="@+id/lblBus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_toEndOf="@id/ivBusIcon"
                            android:layout_marginStart="12dp"
                            android:text="ASSIGNED BUS"
                            android:textColor="#8E8E93"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvBusNumber"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_below="@id/lblBus"
                            android:layout_toEndOf="@id/ivBusIcon"
                            android:layout_marginStart="12dp"
                            android:layout_marginTop="2dp"
                            android:textColor="@color/black"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            tools:text="Bus 42" />
                    </RelativeLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1.5dp"
                        android:background="#D1D1D6"
                        android:layout_marginBottom="20dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="4dp"
                            android:layout_height="20dp"
                            android:background="#FFCC00" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="Parent Details"
                            android:textColor="#111111"
                            android:textSize="18sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@android:drawable/toast_frame"
                        android:backgroundTint="#F2F2F7"
                        android:orientation="vertical"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="12dp"
                        android:layout_marginBottom="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Father Name"
                            android:textColor="#8E8E93"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tvFatherName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textColor="#1C1C1E"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            tools:text="Ahmed Khan" />
                    </LinearLayout>

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@android:drawable/toast_frame"
                        android:backgroundTint="#F2F2F7"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="12dp"
                        android:layout_marginBottom="24dp">

                        <TextView
                            android:id="@+id/lblContact"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Contact Number"
                            android:textColor="#8E8E93"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tvPhoneNumber"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_below="@id/lblContact"
                            android:layout_marginTop="2dp"
                            android:textColor="#1C1C1E"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            tools:text="+92 300 1234567" />

                        <ImageView
                            android:id="@+id/ivCallAction"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerInParent="true"
                            android:src="@drawable/phone_24"
                            app:tint="#005DB7" />
                    </RelativeLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAssignRouteAction"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:layout_marginTop="12dp"
                        app:backgroundTint="#0A1D37"
                        android:text="Assign Optimized Route"
                        android:textAllCaps="false"
                        android:textColor="@color/white"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        app:icon="@drawable/alt_route"
                        app:iconGravity="textStart"
                        app:iconTint="@color/white"
                        app:cornerRadius="12dp"
                        android:visibility="gone"
                        tools:visibility="visible"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnEditDetails"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:layout_marginTop="12dp"
                        android:text="Edit Details"
                        android:textAllCaps="false"
                        android:textColor="@color/primaryBlue"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        app:icon="@drawable/outline_edit_24"
                        app:iconGravity="textStart"
                        app:iconTint="@color/primaryBlue"
                        app:strokeColor="@color/primaryBlue"
                        app:cornerRadius="12dp"
                        app:strokeWidth="1.5dp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDeleteStudent"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:layout_marginTop="12dp"
                        app:backgroundTint="#FFEBEE"
                        android:text="Delete Student"
                        android:textAllCaps="false"
                        android:textColor="#D32F2F"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        app:icon="@drawable/outline_delete_24"
                        app:iconGravity="textStart"
                        app:iconTint="#D32F2F"
                        app:strokeColor="#FFEBEE"
                        app:cornerRadius="12dp"
                        app:strokeWidth="0dp"/>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>