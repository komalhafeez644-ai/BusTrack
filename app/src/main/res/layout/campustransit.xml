<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light">

    <!-- Map Background (Only for full screen mode) -->
    <ImageView
        android:id="@+id/mapBg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.8"
        android:scaleType="centerCrop"
        android:src="@android:drawable/ic_menu_mapmode" />

    <!-- Top Floating Header (Only for full screen mode) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/headerCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="20dp"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="24dp"
        app:cardElevation="10dp"
        app:strokeWidth="0dp"
        app:layout_constraintTop_toTopOf="parent">

        <RelativeLayout
            android:layout_width="match_parent"
            android:padding="14dp"
            android:layout_height="wrap_content">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivDriverSmall"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_driver"
                android:scaleType="centerCrop"
                app:shapeAppearanceOverlay="@style/CircleImage"
                app:strokeWidth="1dp"
                app:strokeColor="#F1F5F9" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="16dp"
                android:layout_toEndOf="@id/ivDriverSmall"
                android:text="Campus Transit"
                android:textColor="#0D1B3E"
                android:textSize="22sp"
                android:textStyle="bold" />

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:src="@drawable/settings"
                app:tint="#2563EB" />
        </RelativeLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Main Manifest Card (Container for BottomSheet) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/manifestCard"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="220dp"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="0dp"
        app:shapeAppearance="@style/BottomSheetShape"
        app:cardElevation="16dp"
        app:strokeWidth="0dp"
        app:layout_constraintBottom_toTopOf="@id/navCard"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Drag Handle -->
            <View
                android:layout_width="50dp"
                android:layout_height="5dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="16dp"
                android:background="#E2E8F0" />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvCurrentStopName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Bahria Gate Stop"
                        android:textColor="#0D1B3E"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="🕒 Scheduled: 07:12 AM"
                        android:textColor="#64748B"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- Arrived Badge -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    app:cardBackgroundColor="#DCFCE7"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#10B981"
                    app:strokeWidth="1dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="6dp"
                        android:text="ARRIVED"
                        android:textColor="#10B981"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </com.google.android.material.card.MaterialCardView>
            </RelativeLayout>

            <!-- Manifest Section Removed as requested -->

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="12dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Student 1 -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardS1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        app:cardBackgroundColor="#FFFFFF"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="3dp"
                        app:strokeColor="#F1F5F9"
                        app:strokeWidth="1dp">

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="14dp">

                            <com.google.android.material.imageview.ShapeableImageView
                                android:id="@+id/ivStudentS1"
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:src="@drawable/ic_driver"
                                app:shapeAppearanceOverlay="@style/CircleImage"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toStartOf="@+id/barrierS1"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent"
                                android:layout_marginStart="60dp">

                                <TextView
                                    android:id="@+id/tvStudentNameS1"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Ali Hamza"
                                    android:textColor="#0F172A"
                                    android:textSize="17sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/tvStudentDetailsS1"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="ID: #FC-9901 • BSCS"
                                    android:textColor="#64748B"
                                    android:textSize="13sp" />
                            </LinearLayout>

                            <androidx.constraintlayout.widget.Barrier
                                android:id="@+id/barrierS1"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                app:barrierDirection="start"
                                app:constraint_referenced_ids="layoutMarkS1,layoutStatusS1" />

                            <!-- Mark Attendance Buttons -->
                            <LinearLayout
                                android:id="@+id/layoutMarkS1"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:visibility="visible"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toTopOf="parent">

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnAbsentS1"
                                    style="@style/Widget.Material3.Button.TonalButton"
                                    android:layout_width="48dp"
                                    android:layout_height="44dp"
                                    android:layout_marginEnd="8dp"
                                    android:padding="0dp"
                                    android:insetLeft="0dp"
                                    android:insetTop="0dp"
                                    android:insetRight="0dp"
                                    android:insetBottom="0dp"
                                    app:backgroundTint="#FEE2E2"
                                    app:cornerRadius="12dp"
                                    app:icon="@drawable/crosscircle"
                                    app:iconGravity="textStart"
                                    app:iconPadding="0dp"
                                    app:iconSize="28dp"
                                    app:iconTint="#EF4444" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnPresentS1"
                                    style="@style/Widget.Material3.Button.TonalButton"
                                    android:layout_width="48dp"
                                    android:layout_height="44dp"
                                    android:padding="0dp"
                                    android:insetLeft="0dp"
                                    android:insetTop="0dp"
                                    android:insetRight="0dp"
                                    android:insetBottom="0dp"
                                    app:backgroundTint="#DCFCE7"
                                    app:cornerRadius="12dp"
                                    app:icon="@drawable/checkcircle"
                                    app:iconGravity="textStart"
                                    app:iconPadding="0dp"
                                    app:iconSize="28dp"
                                    app:iconTint="#10B981" />
                            </LinearLayout>

                            <!-- Status Display -->
                            <LinearLayout
                                android:id="@+id/layoutStatusS1"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:visibility="gone"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toTopOf="parent">

                                <TextView
                                    android:id="@+id/tvStatusBadgeS1"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:background="@drawable/bg_badge"
                                    android:paddingHorizontal="12dp"
                                    android:paddingVertical="6dp"
                                    android:text="PRESENT"
                                    android:textColor="#10B981"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />

                                <ImageView
                                    android:id="@+id/btnEditS1"
                                    android:layout_width="32dp"
                                    android:layout_height="32dp"
                                    android:layout_marginStart="8dp"
                                    android:background="?attr/selectableItemBackgroundBorderless"
                                    android:padding="6dp"
                                    android:src="@drawable/edit"
                                    app:tint="#94A3B8" />
                            </LinearLayout>

                        </androidx.constraintlayout.widget.ConstraintLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Student 2 -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardS2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        app:cardBackgroundColor="#FFFFFF"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="3dp"
                        app:strokeColor="#F1F5F9"
                        app:strokeWidth="1dp">

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="14dp">

                            <com.google.android.material.imageview.ShapeableImageView
                                android:id="@+id/ivStudentS2"
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:src="@drawable/ic_driver"
                                app:shapeAppearanceOverlay="@style/CircleImage"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toStartOf="@+id/barrierS2"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent"
                                android:layout_marginStart="60dp">

                                <TextView
                                    android:id="@+id/tvStudentNameS2"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Sarah Jenkins"
                                    android:textColor="#0F172A"
                                    android:textSize="17sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/tvStudentDetailsS2"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="ID: #FC-9021 • BBA"
                                    android:textColor="#64748B"
                                    android:textSize="13sp" />
                            </LinearLayout>

                            <androidx.constraintlayout.widget.Barrier
                                android:id="@+id/barrierS2"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                app:barrierDirection="start"
                                app:constraint_referenced_ids="layoutMarkS2,layoutStatusS2" />

                            <!-- Mark Attendance Buttons -->
                            <LinearLayout
                                android:id="@+id/layoutMarkS2"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:visibility="visible"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toTopOf="parent">

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnAbsentS2"
                                    style="@style/Widget.Material3.Button.TonalButton"
                                    android:layout_width="48dp"
                                    android:layout_height="44dp"
                                    android:layout_marginEnd="8dp"
                                    android:padding="0dp"
                                    android:insetLeft="0dp"
                                    android:insetTop="0dp"
                                    android:insetRight="0dp"
                                    android:insetBottom="0dp"
                                    app:backgroundTint="#FEE2E2"
                                    app:cornerRadius="12dp"
                                    app:icon="@drawable/crosscircle"
                                    app:iconGravity="textStart"
                                    app:iconPadding="0dp"
                                    app:iconSize="28dp"
                                    app:iconTint="#EF4444" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnPresentS2"
                                    style="@style/Widget.Material3.Button.TonalButton"
                                    android:layout_width="48dp"
                                    android:layout_height="44dp"
                                    android:padding="0dp"
                                    android:insetLeft="0dp"
                                    android:insetTop="0dp"
                                    android:insetRight="0dp"
                                    android:insetBottom="0dp"
                                    app:backgroundTint="#DCFCE7"
                                    app:cornerRadius="12dp"
                                    app:icon="@drawable/checkcircle"
                                    app:iconGravity="textStart"
                                    app:iconPadding="0dp"
                                    app:iconSize="28dp"
                                    app:iconTint="#10B981" />
                            </LinearLayout>

                            <!-- Status Display -->
                            <LinearLayout
                                android:id="@+id/layoutStatusS2"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:visibility="gone"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toTopOf="parent">

                                <TextView
                                    android:id="@+id/tvStatusBadgeS2"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:background="@drawable/bg_badge"
                                    android:paddingHorizontal="12dp"
                                    android:paddingVertical="6dp"
                                    android:text="PRESENT"
                                    android:textColor="#10B981"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />

                                <ImageView
                                    android:id="@+id/btnEditS2"
                                    android:layout_width="32dp"
                                    android:layout_height="32dp"
                                    android:layout_marginStart="8dp"
                                    android:background="?attr/selectableItemBackgroundBorderless"
                                    android:padding="6dp"
                                    android:src="@drawable/edit"
                                    app:tint="#94A3B8" />
                            </LinearLayout>

                        </androidx.constraintlayout.widget.ConstraintLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:src="@drawable/cloudsync"
                            app:tint="#2563EB" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="Syncing..."
                            android:textColor="#64748B"
                            android:textSize="12sp" />
                    </LinearLayout>

                </LinearLayout>
            </ScrollView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSkip"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="0.4"
                    android:text="SKIP"
                    android:textColor="#64748B"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:cornerRadius="16dp"
                    app:strokeColor="#E2E8F0"
                    app:strokeWidth="1dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSaveAttendance"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_marginStart="12dp"
                    android:layout_weight="0.6"
                    android:backgroundTint="#0D1B3E"
                    android:text="SAVE ATTENDANCE"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:cornerRadius="16dp" />
            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Bottom Navigation Card (Only for full screen mode) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/navCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardElevation="20dp"
        app:strokeWidth="0dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottomNav"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:background="@color/white"
            app:itemIconTint="@color/nav_item_color"
            app:itemTextColor="@color/nav_item_color"
            app:labelVisibilityMode="labeled"
            app:menu="@menu/profile_nav_menu" />
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
