<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="16dp"
    app:cardElevation="3dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Bus Icon -->
        <FrameLayout
            android:id="@+id/frameBusIcon"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_bus_circle_blue"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/ivBusGraphic"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/directions_bus_unfilled"
                app:tint="#1E88E5" />
        </FrameLayout>

        <!-- Bus Number -->
        <TextView
            android:id="@+id/tvBusNumTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:textColor="#000000"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintStart_toEndOf="@id/frameBusIcon"
            app:layout_constraintTop_toTopOf="@id/frameBusIcon"
            tools:text="BUS-102" />

        <TextView
            android:id="@+id/tvStatusBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_chip_selected"
            android:backgroundTint="#E8F5E9"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            android:text="ACTIVE"
            android:textColor="#2E7D32"
            android:textSize="10sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/tvBusNumTitle"
            app:layout_constraintStart_toEndOf="@id/tvBusNumTitle"
            app:layout_constraintTop_toTopOf="@id/tvBusNumTitle" />

        <!-- Row 1 -->
        <LinearLayout
            android:id="@+id/layoutMetaGroup1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal"
            app:layout_constraintEnd_toStartOf="@+id/ivEditAction"
            app:layout_constraintStart_toStartOf="@id/tvBusNumTitle"
            app:layout_constraintTop_toBottomOf="@id/tvBusNumTitle">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_gravity="center_vertical"
                android:src="@drawable/outline_seat"
                app:tint="#666666" />

            <TextView
                android:id="@+id/txtSeatsVal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:textColor="#666666"
                android:textSize="12sp"
                tools:text="40 Seats" />

            <ImageView
                android:id="@+id/ivDriverMetaIcon"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="14dp"
                android:src="@drawable/ic_person"
                app:tint="#666666" />

            <TextView
                android:id="@+id/txtDriverVal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:textColor="#666666"
                android:textSize="12sp"
                tools:text="John Doe" />
        </LinearLayout>

        <!-- Row 2 -->
        <LinearLayout
            android:id="@+id/layoutMetaGroup2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal"
            app:layout_constraintEnd_toStartOf="@+id/ivEditAction"
            app:layout_constraintStart_toStartOf="@id/tvBusNumTitle"
            app:layout_constraintTop_toBottomOf="@id/layoutMetaGroup1">

            <ImageView
                android:id="@+id/ivRouteMetaIcon"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_gravity="center_vertical"
                android:src="@drawable/alt_route"
                app:tint="#666666" />

            <TextView
                android:id="@+id/txtRouteVal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:textColor="#666666"
                android:textSize="12sp"
                tools:text="North Express" />
        </LinearLayout>

        <!-- Edit Icon -->
        <ImageView
            android:id="@+id/ivEditAction"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginEnd="14dp"
            android:src="@drawable/outline_edit_24"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/switchBusStatus"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="#555555" />

        <!-- Switch -->
        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchBusStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text=""
            app:thumbTint="@color/white"
            app:trackTint="@color/primaryBlue"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>